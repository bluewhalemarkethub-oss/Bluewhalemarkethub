        "status": {
          "type": "string",
          "enum": ["Pending", "Approved", "Rejected"]
        },
        "adminNote": {
          "type": "string",
          "maxLength": 300
        },
        "rejectionReason": {
          "type": "string",
          "maxLength": 500
        },
        "reviewedBy": {
          "type": "string",
          "maxLength": 160
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time"
        },
        "rejectedAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "userEmail",
        "username",
        "amount",
        "currency",
        "walletAddress",
        "txHash",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },

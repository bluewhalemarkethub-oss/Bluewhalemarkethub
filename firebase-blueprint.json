          "type": "string",
          "maxLength": 300
        },
        "requireRegistrationApproval": {
          "type": "boolean"
        },
        "updatedBy": {
          "type": "string",
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "registrationFeeUsd",
        "minimumDepositUsd",
        "supportEmail",
        "marketplaceNotice",
        "requireRegistrationApproval",
        "updatedBy",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "User account metadata, role, verification status, last login date, and wallet balance summary."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated PII document storing user email, phone number, and last login IP."
    },
    "/deposits/{depositId}": {
      "schema": { "$ref": "#/entities/Deposit" },
      "description": "Crypto deposit submissions pending admin verification."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/ShippingOrder" },
      "description": "Purchased shipping services and order fulfillment status."
    },
    "/transactions/{txId}": {
      "schema": { "$ref": "#/entities/WalletTransaction" },
      "description": "Unified wallet transaction ledger."
    },
    "/notifications/{notifId}": {
      "schema": { "$ref": "#/entities/EmailNotification" },
      "description": "Email notification log for registration, approval, suspension, deposit approval, purchases, price drop alerts, and password reset."
    },
    "/loginLogs/{logId}": {
      "schema": { "$ref": "#/entities/LoginActivity" },
      "description": "Session and IP tracking logs per user."
    },
    "/supportTickets/{ticketId}": {
      "schema": { "$ref": "#/entities/SupportTicket" },
      "description": "Support tickets and live chat sessions."
    },
    "/supportTickets/{ticketId}/messages/{msgId}": {
      "schema": { "$ref": "#/entities/SupportMessage" },
      "description": "Support ticket and live chat conversation messages."
    },
    "/servicePricing/{serviceId}": {
      "schema": { "$ref": "#/entities/ServicePriceOverride" },
      "description": "Admin-managed live pricing overrides for verified account packages."
    },
    "/priceAlerts/{alertId}": {
      "schema": { "$ref": "#/entities/PriceAlert" },
      "description": "User-configured target price drop alerts for specific services, tiers, and countries."
    },
    "/registrationPayments/{paymentId}": {
      "schema": { "$ref": "#/entities/RegistrationPayment" },
      "description": "Mandatory $5 registration fee submissions awaiting admin approval."
    },
    "/adminLogs/{logId}": {
      "schema": { "$ref": "#/entities/AdminLog" },
      "description": "Immutable administrator audit trail for approvals, suspensions, status changes, and platform updates."
    },
    "/siteSettings/{settingId}": {
      "schema": { "$ref": "#/entities/SiteSettings" },
      "description": "Publicly readable website settings writable exclusively by the administrator."
    }
  }
}

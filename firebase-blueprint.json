{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Account profile, referral code, loyalty points, and wallet ledger summary for a BlueWhale Markethub member.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "username": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-.]+$"
        },
        "country": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64
        },
        "role": {
          "type": "string",
          "enum": ["customer", "admin"]
        },
        "status": {
          "type": "string",
          "enum": ["Pending Payment", "Approved", "Rejected", "Suspended", "active", "suspended"]
        },
        "account_status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected", "suspended"]
        },
        "payment_status": {
          "type": "string",
          "enum": ["unpaid", "pending_verification", "verified", "rejected"]
        },
        "dashboard_access": {
          "type": "boolean"
        },
        "isVerified": {
          "type": "boolean"
        },
        "walletBalance": {
          "type": "number"
        },
        "totalDeposits": {
          "type": "number"
        },
        "totalPurchases": {
          "type": "number"
        },
        "twoFactorEnabled": {
          "type": "boolean"
        },
        "registrationPaymentStatus": {
          "type": "string",
          "enum": ["Unpaid", "Pending Review", "Approved", "Rejected"]
        },
        "registrationPaymentId": {
          "type": "string",
          "maxLength": 128
        },
        "registrationTxId": {
          "type": "string",
          "maxLength": 160
        },
        "registrationCrypto": {
          "type": "string",
          "enum": ["BTC", "ETH", "USDT_ERC20", "USDT_TRC20"]
        },
        "registrationFeeAmount": {
          "type": "number"
        },
        "registrationReceiptDataUrl": {
          "type": "string",
          "maxLength": 450000
        },
        "registrationReceiptFileName": {
          "type": "string",
          "maxLength": 160
        },
        "registrationSubmittedAt": {
          "type": "string",
          "format": "date-time"
        },
        "paymentVerifiedAt": {
          "type": "string",
          "format": "date-time"
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time"
        },
        "rejectedAt": {
          "type": "string",
          "format": "date-time"
        },
        "rejectionReason": {
          "type": "string",
          "maxLength": 500
        },
        "adminNotes": {
          "type": "string",
          "maxLength": 1000
        },
        "lastLoginAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "fullName",
        "username",
        "country",
        "role",
        "status",
        "isVerified",
        "walletBalance",
        "totalDeposits",
        "totalPurchases",
        "twoFactorEnabled",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
